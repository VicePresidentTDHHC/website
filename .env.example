# Copy to .env and fill in after you create the GitHub account.
# .env is gitignored — never commit real secrets.

# GitHub (org/user that owns the TDHHC site repo)
GITHUB_OWNER=VicePresidentTDHHC
GITHUB_REPO=website
GITHUB_USERNAME=VicePresidentTDHHC

# Prefer a fine-grained Personal Access Token (not your login password).
# Create at: https://github.com/settings/tokens?type=beta
# Scopes: Contents + Metadata on TDHHC/website (and admin:org if creating the org via API).
GITHUB_TOKEN=

# InterServer FTP — put these in GitHub Actions secrets (not only here):
#   FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, FTP_SERVER_DIR
# Flow: edit → push to GitHub master → Actions deploys www/ to InterServer.
# Do NOT point GoDaddy DNS until Board votes.
INTERSERVER_FTP_HOST=
INTERSERVER_FTP_USER=
INTERSERVER_FTP_PASSWORD=
INTERSERVER_DOCROOT=./public_html
INTERSERVER_IP=

# Optional later
# BOLT_...=
