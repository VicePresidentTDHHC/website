# Copy to .env and fill in after you create the GitHub account.
# .env is gitignored — never commit real secrets.

# GitHub (org/user that owns the TDHHC site repo)
GITHUB_OWNER=VicePresidentTDHHC
GITHUB_REPO=website
GITHUB_USERNAME=VicePresidentTDHHC

# Prefer a fine-grained Personal Access Token (not your login password).
# Create at: https://github.com/settings/tokens?type=beta
# Permissions: Contents (Read and write) + Metadata on website.
GITHUB_TOKEN=

# Hosting.com FTP — put these in GitHub Actions (not only here):
#   Variables: FTP_SERVER, FTP_USERNAME
#   Secrets:   FTP_PASSWORD
# Panel: https://my.hosting.com → Manage site → FTP Accounts / Site Information
# Flow: edit (Bolt or local) → push to GitHub master → Actions deploys www/ to Hosting.com.
# Do NOT point DNS at Hosting.com until Board votes.
HOSTING_FTP_HOST=
HOSTING_FTP_USER=
HOSTING_FTP_PASSWORD=
HOSTING_DOCROOT=./public_html
